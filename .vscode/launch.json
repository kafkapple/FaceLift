    "configurations": [
        {
            "name": "Debug: Quick Test (10 steps)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_gslrm.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "/home/joon/anaconda3/envs/facelift/bin/python",
